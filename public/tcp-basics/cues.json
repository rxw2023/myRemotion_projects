  "s18": {
    "duration": 33.576,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "快速恢复的思路是：别退回起点，太亏。",
        "offset": 1000000,
        "duration": 37841347
      },
      {
        "type": "SentenceBoundary",
        "text": "三个重复确认说明网络还在送数据，只是丢了一个包。",
        "offset": 38341347,
        "duration": 46634617
      },
      {
        "type": "SentenceBoundary",
        "text": "所以处理轻一点：阈值同样砍一半。",
        "offset": 84975964,
        "duration": 36418270
      },
      {
        "type": "SentenceBoundary",
        "text": "但窗口不回到起点，教材口径是直接等于砍半后的阈值。",
        "offset": 121394235,
        "duration": 49399040
      },
      {
        "type": "SentenceBoundary",
        "text": "然后进入拥塞避免，线性往上爬。",
        "offset": 170793275,
        "duration": 34134616
      },
      {
        "type": "SentenceBoundary",
        "text": "Reno 的实现多一步：窗口等于阈值加三。",
        "offset": 204927892,
        "duration": 35697116
      },
      {
        "type": "SentenceBoundary",
        "text": "加三是因为有三个报文段已经离开网络，被对方收下了。",
        "offset": 240625008,
        "duration": 45673078
      },
      {
        "type": "SentenceBoundary",
        "text": "考试按教材写就行，题目点名 Reno 才用加三。",
        "offset": 286298087,
        "duration": 49038463
      }
    ],
