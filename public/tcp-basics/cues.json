  "s10": {
    "duration": 42.432,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "窗口有三个名字，别混：发送窗口、接收窗口、拥塞窗口。",
        "offset": 1000000,
        "duration": 60798079
      },
      {
        "type": "SentenceBoundary",
        "text": "发送窗口等于接收窗口和拥塞窗口里较小的那个。",
        "offset": 61298079,
        "duration": 45432693
      },
      {
        "type": "SentenceBoundary",
        "text": "接收窗口是接收方还空着的缓冲区，写在确认报文的窗口字段里。",
        "offset": 106730773,
        "duration": 57812502
      },
      {
        "type": "SentenceBoundary",
        "text": "拥塞窗口是发送方自己估的网络容量，由拥塞控制来调。",
        "offset": 164543275,
        "duration": 53245194
      },
      {
        "type": "SentenceBoundary",
        "text": "用接收窗口去限制发送方，这就是流量控制。",
        "offset": 217788469,
        "duration": 42548078
      },
      {
        "type": "SentenceBoundary",
        "text": "缓冲区满了，接收方通告零窗口，发送方就得停。",
        "offset": 260336548,
        "duration": 47596155
      },
      {
        "type": "SentenceBoundary",
        "text": "停住之后，发送方还会周期性发零窗口探测，问一句能收了吗。",
        "offset": 307932703,
        "duration": 59254809
      },
      {
        "type": "SentenceBoundary",
        "text": "流量控制管两端的快慢，拥塞控制管整条网络，两回事。",
        "offset": 367187513,
        "duration": 56610578
      }
    ],
