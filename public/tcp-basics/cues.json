  "s19": {
    "duration": 37.272,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "最后把整张图串一遍。",
        "offset": 1000000,
        "duration": 22336539
      },
      {
        "type": "SentenceBoundary",
        "text": "建立连接三次握手，断开四次挥手，收尾多等两倍报文寿命。",
        "offset": 22836539,
        "duration": 55288463
      },
      {
        "type": "SentenceBoundary",
        "text": "传数据靠滑动窗口，窗口取接收窗口和拥塞窗口里小的那个。",
        "offset": 78125002,
        "duration": 57692309
      },
      {
        "type": "SentenceBoundary",
        "text": "丢了靠序列号和确认号发现，要么超时重传，要么快速重传。",
        "offset": 135817312,
        "duration": 55889425
      },
      {
        "type": "SentenceBoundary",
        "text": "拥塞控制四件套：慢开始指数涨，拥塞避免线性涨。",
        "offset": 191706737,
        "duration": 51322117
      },
      {
        "type": "SentenceBoundary",
        "text": "超时就砍半归零，三个重复确认就快速重传加快速恢复。",
        "offset": 243028855,
        "duration": 57932694
      },
      {
        "type": "SentenceBoundary",
        "text": "把这些连成一条线，TCP 的题基本都有抓手。",
        "offset": 300961549,
        "duration": 40024039
      },
      {
        "type": "SentenceBoundary",
        "text": "有帮助的话点个赞，我们下期见。",
        "offset": 340985589,
        "duration": 31129808
      }
    ],
