  "s02": {
    "duration": 31.992,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "打开一个 TCP 报文段，固定首部二十字节。",
        "offset": 1000000,
        "duration": 40245193
      },
      {
        "type": "SentenceBoundary",
        "text": "最长能到六十字节，多出来的是选项。",
        "offset": 40745193,
        "duration": 32451924
      },
      {
        "type": "SentenceBoundary",
        "text": "前四个字节是源端口和目的端口，各十六位。",
        "offset": 73197118,
        "duration": 42427886
      },
      {
        "type": "SentenceBoundary",
        "text": "它们负责找到两端的进程。",
        "offset": 115625004,
        "duration": 23557693
      },
      {
        "type": "SentenceBoundary",
        "text": "接着是序列号，三十二位，指向本报文段数据的第一个字节。",
        "offset": 139182697,
        "duration": 50120194
      },
      {
        "type": "SentenceBoundary",
        "text": "然后是确认号，三十二位，表示下一个想收到的字节序号。",
        "offset": 189302891,
        "duration": 47956732
      },
      {
        "type": "SentenceBoundary",
        "text": "确认号只有在确认标志置一时才有意义。",
        "offset": 237259624,
        "duration": 37019232
      },
      {
        "type": "SentenceBoundary",
        "text": "后面依次是首部长度、保留位、六个标志位。",
        "offset": 274278856,
        "duration": 45072117
      }
    ],
