  "s11": {
    "duration": 37.176,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "可靠传输的第一块砖，是序列号和确认号。",
        "offset": 1000000,
        "duration": 38081732
      },
      {
        "type": "SentenceBoundary",
        "text": "确认号是累计确认，表示它之前的字节，一个不少全收到了。",
        "offset": 38581732,
        "duration": 50961540
      },
      {
        "type": "SentenceBoundary",
        "text": "三种情形。",
        "offset": 89543272,
        "duration": 15024039
      },
      {
        "type": "SentenceBoundary",
        "text": "第一种，数据段丢了。",
        "offset": 104567311,
        "duration": 24278847
      },
      {
        "type": "SentenceBoundary",
        "text": "接收方收不到，确认号就不动，发送方等到超时，重传。",
        "offset": 128846158,
        "duration": 53245194
      },
      {
        "type": "SentenceBoundary",
        "text": "第二种，乱序。",
        "offset": 182091352,
        "duration": 18269231
      },
      {
        "type": "SentenceBoundary",
        "text": "后面的到了，前面的缺口还在。",
        "offset": 200360584,
        "duration": 32091347
      },
      {
        "type": "SentenceBoundary",
        "text": "接收方反复发同一个确认号，发送方连收三个，立刻重传。",
        "offset": 232451931,
        "duration": 55048078
      },
      {
        "type": "SentenceBoundary",
        "text": "第三种，按序到达，确认号往前走，继续发。",
        "offset": 287500010,
        "duration": 43389424
      },
      {
        "type": "SentenceBoundary",
        "text": "记住一句话：确认号不动，就说明有洞。",
        "offset": 330889435,
        "duration": 40384616
      }
    ],
    "cues": [
