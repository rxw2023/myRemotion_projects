  "s05": {
    "duration": 39.528,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "三次握手的本质，是双方各自确认两个方向都能通。",
        "offset": 1000000,
        "duration": 46615386
      },
      {
        "type": "SentenceBoundary",
        "text": "第一次，服务端确认了客户端能发。",
        "offset": 47115386,
        "duration": 34014424
      },
      {
        "type": "SentenceBoundary",
        "text": "第二次，客户端确认了服务端能收也能发。",
        "offset": 81129810,
        "duration": 43149040
      },
      {
        "type": "SentenceBoundary",
        "text": "第三次，服务端确认了客户端收到了自己的序列号。",
        "offset": 124278850,
        "duration": 44591347
      },
      {
        "type": "SentenceBoundary",
        "text": "只握两次行不行？",
        "offset": 168870198,
        "duration": 17908654
      },
      {
        "type": "SentenceBoundary",
        "text": "服务端就无法确认自己的同步报文被收到。",
        "offset": 186778853,
        "duration": 37379809
      },
      {
        "type": "SentenceBoundary",
        "text": "初始序列号一般随机选，用来区分新旧连接。",
        "offset": 224158662,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "注意一个常考细节：初始序列号 x 是给同步报文用的。",
        "offset": 267427894,
        "duration": 48677886
      },
      {
        "type": "SentenceBoundary",
        "text": "第一个数据字节的序号是 x 加一。",
        "offset": 316105780,
        "duration": 33293270
      },
      {
        "type": "SentenceBoundary",
        "text": "第三次握手其实可以带数据，只是多数实现不带。",
        "offset": 349399051,
        "duration": 45312501
      }
    ],
