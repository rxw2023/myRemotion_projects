  "s04": {
    "duration": 32.208,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "连接怎么建立？",
        "offset": 1000000,
        "duration": 15966346
      },
      {
        "type": "SentenceBoundary",
        "text": "靠三次握手。",
        "offset": 16466346,
        "duration": 15504808
      },
      {
        "type": "SentenceBoundary",
        "text": "第一次，客户端发一个同步标志置一的报文，带初始序列号 x。",
        "offset": 31971155,
        "duration": 52644232
      },
      {
        "type": "SentenceBoundary",
        "text": "自己的状态从关闭，变成同步已发送。",
        "offset": 84615387,
        "duration": 35336539
      },
      {
        "type": "SentenceBoundary",
        "text": "服务端原来在监听，收到之后回一个同步加确认。",
        "offset": 119951927,
        "duration": 44471155
      },
      {
        "type": "SentenceBoundary",
        "text": "里面带自己的初始序列号 y，确认号填 x 加一。",
        "offset": 164423082,
        "duration": 43509616
      },
      {
        "type": "SentenceBoundary",
        "text": "服务端状态变成同步已收到。",
        "offset": 207932699,
        "duration": 29447116
      },
      {
        "type": "SentenceBoundary",
        "text": "第三次，客户端回一个确认，确认号填 y 加一。",
        "offset": 237379816,
        "duration": 45673078
      },
      {
        "type": "SentenceBoundary",
        "text": "两边都进入已建立状态，连接就通了。",
        "offset": 283052894,
        "duration": 38581732
      }
    ],
