  "s01": {
    "duration": 30.888,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "第一条，面向连接。",
        "offset": 1000000,
        "duration": 21014423
      },
      {
        "type": "SentenceBoundary",
        "text": "发数据之前先握手，发完之后要挥手。",
        "offset": 21514423,
        "duration": 32932693
      },
      {
        "type": "SentenceBoundary",
        "text": "第二条，可靠交付。",
        "offset": 54447117,
        "duration": 22355770
      },
      {
        "type": "SentenceBoundary",
        "text": "无差错、不丢失、不重复、按顺序。",
        "offset": 76802887,
        "duration": 36418270
      },
      {
        "type": "SentenceBoundary",
        "text": "第三条，面向字节流。",
        "offset": 113221157,
        "duration": 23798077
      },
      {
        "type": "SentenceBoundary",
        "text": "它不关心你的消息边界在哪里。",
        "offset": 137019235,
        "duration": 24759616
      },
      {
        "type": "SentenceBoundary",
        "text": "第四条，全双工。",
        "offset": 161778852,
        "duration": 23076923
      },
      {
        "type": "SentenceBoundary",
        "text": "一条连接里，两边同时收发。",
        "offset": 184855776,
        "duration": 30649039
      },
      {
        "type": "SentenceBoundary",
        "text": "面向字节流这条最关键，后面所有机制都建立在它上面。",
        "offset": 215504815,
        "duration": 51802886
      },
      {
        "type": "SentenceBoundary",
        "text": "因为编号是按字节编的，不是按报文段编的。",
        "offset": 267307702,
        "duration": 41105770
      }
    ],
    "cues": [
      {
        "text": "第一条，面向连接。发数据之前先握手，发完之后要挥手。",
        "start": 0.1,
        "end": 5.445
