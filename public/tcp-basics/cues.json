  "s08": {
    "duration": 36.072,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "数据怎么发？",
        "offset": 1000000,
        "duration": 13802885
      },
      {
        "type": "SentenceBoundary",
        "text": "TCP 不是发一个等一个确认。",
        "offset": 14302885,
        "duration": 24639423
      },
      {
        "type": "SentenceBoundary",
        "text": "它维护一个窗口，窗口里的字节可以连续发出去。",
        "offset": 38942309,
        "duration": 42187501
      },
      {
        "type": "SentenceBoundary",
        "text": "发送方的字节流可以分成四段。",
        "offset": 81129810,
        "duration": 29326924
      },
      {
        "type": "SentenceBoundary",
        "text": "已发送已确认、已发送未确认、可以发还没发、暂时不能发。",
        "offset": 110456734,
        "duration": 53125001
      },
      {
        "type": "SentenceBoundary",
        "text": "中间两段合起来，就是发送窗口。",
        "offset": 163581736,
        "duration": 32091347
      },
      {
        "type": "SentenceBoundary",
        "text": "接收方也一样，分已交付、已收到未交付、等待接收、不许接收。",
        "offset": 195673084,
        "duration": 57692309
      },
      {
        "type": "SentenceBoundary",
        "text": "收到确认之后，窗口左边界右移，右边腾出新的空间。",
        "offset": 253365393,
        "duration": 50240386
      },
      {
        "type": "SentenceBoundary",
        "text": "一句话：确认推着窗口往前走，数据就流水线式地发出去了。",
        "offset": 303605780,
        "duration": 56490386
      }
    ],
