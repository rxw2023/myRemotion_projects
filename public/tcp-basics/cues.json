  "s12": {
    "duration": 33.144,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "超时时间怎么定？",
        "offset": 1000000,
        "duration": 17288462
      },
      {
        "type": "SentenceBoundary",
        "text": "定长了太慢，定短了会误重传。",
        "offset": 17788462,
        "duration": 29687501
      },
      {
        "type": "SentenceBoundary",
        "text": "TCP 采样每次往返时间，算加权平均，叫平滑往返时间。",
        "offset": 47475963,
        "duration": 52884617
      },
      {
        "type": "SentenceBoundary",
        "text": "再算往返时间的波动幅度，叫偏差。",
        "offset": 100360580,
        "duration": 36538462
      },
      {
        "type": "SentenceBoundary",
        "text": "超时时间大约等于平滑往返时间，加上四倍偏差。",
        "offset": 136899043,
        "duration": 45312501
      },
      {
        "type": "SentenceBoundary",
        "text": "网络抖得厉害，就把超时放宽，少误判几次。",
        "offset": 182211545,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "还有个细节：重传过的报文，往返时间样本不能用。",
        "offset": 225480777,
        "duration": 47355770
      },
      {
        "type": "SentenceBoundary",
        "text": "这就是卡恩算法，避免把重传的确认错算成原报文的往返。",
        "offset": 272836548,
        "duration": 58173079
      }
    ],
