  "s03": {
    "duration": 31.8,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "六个标志位里，最常用的是三个：同步、确认、终止。",
        "offset": 1000000,
        "duration": 53466348
      },
      {
        "type": "SentenceBoundary",
        "text": "同步用于建连，终止用于断连，确认表示确认号有效。",
        "offset": 53966348,
        "duration": 52283655
      },
      {
        "type": "SentenceBoundary",
        "text": "还有三个：紧急、推送、复位。",
        "offset": 106250003,
        "duration": 37139424
      },
      {
        "type": "SentenceBoundary",
        "text": "复位比较暴力，直接强制断开连接。",
        "offset": 143389428,
        "duration": 33173078
      },
      {
        "type": "SentenceBoundary",
        "text": "再往后是窗口字段，十六位。",
        "offset": 176562506,
        "duration": 29326924
      },
      {
        "type": "SentenceBoundary",
        "text": "接收方用它告诉对方，我还能收多少字节。",
        "offset": 205889430,
        "duration": 36899039
      },
      {
        "type": "SentenceBoundary",
        "text": "这就是流量控制的抓手。",
        "offset": 242788470,
        "duration": 22235577
      },
      {
        "type": "SentenceBoundary",
        "text": "最后是校验和、紧急指针，再加上可变的选项和填充。",
        "offset": 265024048,
        "duration": 52403848
      }
    ],
