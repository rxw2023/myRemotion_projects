  "s13": {
    "duration": 40.776,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "校验和负责最后一道关：数据在路上被改坏了怎么办。",
        "offset": 1000000,
        "duration": 45052886
      },
      {
        "type": "SentenceBoundary",
        "text": "它覆盖首部和数据，另外还要加一个伪首部。",
        "offset": 45552886,
        "duration": 45192309
      },
      {
        "type": "SentenceBoundary",
        "text": "伪首部里有源地址、目的地址和协议号。",
        "offset": 90745195,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "作用是确认这个报文没被投错地方。",
        "offset": 134014427,
        "duration": 34975962
      },
      {
        "type": "SentenceBoundary",
        "text": "校验不过，接收方直接丢弃，不确认，等发送方重传。",
        "offset": 168990390,
        "duration": 52283655
      },
      {
        "type": "SentenceBoundary",
        "text": "从重传策略看，TCP 介于回退 N 帧和选择重传之间。",
        "offset": 221274046,
        "duration": 53485578
      },
      {
        "type": "SentenceBoundary",
        "text": "它用累计确认，像回退 N。",
        "offset": 274759625,
        "duration": 26682693
      },
      {
        "type": "SentenceBoundary",
        "text": "又缓存乱序段、只重传丢的那一段，像选择重传。",
        "offset": 301442318,
        "duration": 47355770
      },
      {
        "type": "SentenceBoundary",
        "text": "而且整个发送窗口，只给最左边那个未确认的段维护一个定时器。",
        "offset": 348798089,
        "duration": 58413463
      }
    ],
