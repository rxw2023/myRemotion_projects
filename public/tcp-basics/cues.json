  "s14": {
    "duration": 36.84,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "再说拥塞控制。",
        "offset": 1000000,
        "duration": 18490385
      },
      {
        "type": "SentenceBoundary",
        "text": "它管的不是一条连接，是整条链路。",
        "offset": 18990385,
        "duration": 33894232
      },
      {
        "type": "SentenceBoundary",
        "text": "目标不是自己快，是大家加起来不过载。",
        "offset": 52884617,
        "duration": 34014424
      },
      {
        "type": "SentenceBoundary",
        "text": "发送方维护一个拥塞窗口，实际发多少还要跟接收窗口取小。",
        "offset": 86899041,
        "duration": 56971155
      },
      {
        "type": "SentenceBoundary",
        "text": "连接刚开始，窗口从很小起步，这叫慢开始。",
        "offset": 143870197,
        "duration": 43870193
      },
      {
        "type": "SentenceBoundary",
        "text": "每收到一个确认，窗口加一个最大报文段。",
        "offset": 187740391,
        "duration": 35456732
      },
      {
        "type": "SentenceBoundary",
        "text": "一个往返时间里确认数翻倍，所以窗口是指数增长。",
        "offset": 223197123,
        "duration": 52163463
      },
      {
        "type": "SentenceBoundary",
        "text": "注意，是每收到一个确认加一，不是收到一个确认就翻倍。",
        "offset": 275360587,
        "duration": 46033655
      },
      {
        "type": "SentenceBoundary",
        "text": "涨到慢开始阈值，就换挡，进入拥塞避免。",
        "offset": 321394242,
        "duration": 46394232
      }
    ],
