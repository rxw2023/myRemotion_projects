    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "断开连接要四次挥手。",
        "offset": 1000000,
        "duration": 25461539
      },
      {
        "type": "SentenceBoundary",
        "text": "第一次，客户端发终止标志，序列号 u，表示我没数据要发了。",
        "offset": 25961539,
        "duration": 58533655
      },
      {
        "type": "SentenceBoundary",
        "text": "客户端进入终止等待一。",
        "offset": 84495195,
        "duration": 26201924
      },
