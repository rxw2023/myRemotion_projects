{
  "s00": {
    "duration": 23.424,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "传输层有两位主角，TCP 管可靠，UDP 管快。",
        "offset": 1000000,
        "duration": 47216347
      },
      {
        "type": "SentenceBoundary",
        "text": "TCP 站在不可靠的 IP 之上，要造出一条可靠的管道。",
        "offset": 47716347,
        "duration": 47716347
      },
      {
        "type": "SentenceBoundary",
        "text": "它得解决四件事：连得上、送得到、不乱序、不把网络压垮。",
        "offset": 95432695,
        "duration": 58052886
      },
      {
        "type": "SentenceBoundary",
        "text": "这一期按四条线走：连接、传输、流量、拥塞。",
        "offset": 153485582,
        "duration": 51442309
      },
      {
        "type": "SentenceBoundary",
        "text": "先看它给自己立下的四条规矩。",
        "offset": 204927892,
        "duration": 28725962
      }
    ],
    "cues": [
