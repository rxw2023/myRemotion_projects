  "s17": {
    "duration": 27.696,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "等定时器太慢，快速重传是另一条路。",
        "offset": 1000000,
        "duration": 36158655
      },
      {
        "type": "SentenceBoundary",
        "text": "接收方发现中间缺了一段，会一直重复发同一个确认号。",
        "offset": 36658655,
        "duration": 48076924
      },
      {
        "type": "SentenceBoundary",
        "text": "发送方连收三个重复的确认，就明白那一段丢了。",
        "offset": 84735580,
        "duration": 45432693
      },
      {
        "type": "SentenceBoundary",
        "text": "不用等定时器，立刻重传那一段。",
        "offset": 130168274,
        "duration": 30048078
      },
      {
        "type": "SentenceBoundary",
        "text": "这里的三个是冗余的，算上第一个正常的，一共收到四个相同的确认号。",
        "offset": 160216352,
        "duration": 56610578
      },
      {
        "type": "SentenceBoundary",
        "text": "快速重传只管重传动作，窗口怎么变，要看有没有快速恢复。",
        "offset": 216826931,
        "duration": 59495194
      }
    ],
