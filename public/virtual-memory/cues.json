  "s01": {
    "duration": 39.192,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "物理内存，就是主板上的 RAM 芯片，真实存在的硬件。",
        "offset": 1000000,
        "duration": 50461540
      },
      {
        "type": "SentenceBoundary",
        "text": "访问它必须用物理地址，也就是每个存储单元的唯一编号。",
        "offset": 50961540,
        "duration": 46754809
      },
      {
        "type": "SentenceBoundary",
        "text": "虚拟内存不是一块硬件，它是一种内存管理技术。",
        "offset": 97716349,
        "duration": 42307693
      },
      {
        "type": "SentenceBoundary",
        "text": "它让每个进程都以为自己独占一块连续的内存。",
        "offset": 140024043,
        "duration": 43509616
      },
      {
        "type": "SentenceBoundary",
        "text": "哪怕物理内存不够用，或者被别的进程切得很散。",
        "offset": 183533660,
        "duration": 38942309
      },
      {
        "type": "SentenceBoundary",
        "text": "进程只用虚拟地址，不需要知道物理内存还剩多少。",
        "offset": 222475969,
        "duration": 50240386
      },
      {
        "type": "SentenceBoundary",
        "text": "要访问数据时，操作系统和硬件把虚拟地址翻译成物理地址。",
        "offset": 272716356,
        "duration": 57572117
      },
      {
        "type": "SentenceBoundary",
        "text": "一句话：进程管虚拟地址，硬件管翻译，物理内存管落地。",
        "offset": 330288473,
        "duration": 61057694
      }
    ],
    "cues": [
