  "s19": {
    "duration": 42.84,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "最后把整条链串一遍。",
        "offset": 1000000,
        "duration": 22096154
      },
      {
        "type": "SentenceBoundary",
        "text": "虚拟存储器把逻辑地址和物理内存解耦，程序看到连续空间，实际分散。",
        "offset": 22596154,
        "duration": 64423079
      },
      {
        "type": "SentenceBoundary",
        "text": "空间切成页，地址切成页号加偏移。",
        "offset": 87019233,
        "duration": 36899039
      },
      {
        "type": "SentenceBoundary",
        "text": "翻译靠页表，单级一次，多级多次。",
        "offset": 123918273,
        "duration": 36057693
      },
      {
        "type": "SentenceBoundary",
        "text": "为了少访存，加了 TLB，用虚拟页号查。",
        "offset": 159975967,
        "duration": 39302886
      },
      {
        "type": "SentenceBoundary",
        "text": "页不在内存就缺页，内核调页、改页表、重新执行。",
        "offset": 199278853,
        "duration": 53605771
      },
      {
        "type": "SentenceBoundary",
        "text": "缺页多了要置换，脏页还得写回。",
        "offset": 252884624,
        "duration": 33653847
      },
      {
        "type": "SentenceBoundary",
        "text": "一条链：虚拟地址、TLB、页表、物理地址、cache、主存。",
        "offset": 286538472,
        "duration": 66586540
      },
      {
        "type": "SentenceBoundary",
        "text": "把这条链画熟，408 的存储大题就有抓手了。",
        "offset": 353125012,
        "duration": 43750001
      },
      {
        "type": "SentenceBoundary",
        "text": "有帮助的话点个赞，我们下期见。",
        "offset": 396875014,
        "duration": 31129808
      }
