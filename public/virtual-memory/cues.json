  "s00": {
    "duration": 36.024,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "物理内存就那么多，程序却越开越大。",
        "offset": 1000000,
        "duration": 34716347
      },
      {
        "type": "SentenceBoundary",
        "text": "怎么办？",
        "offset": 35216347,
        "duration": 10697115
      },
      {
        "type": "SentenceBoundary",
        "text": "答案是把内存虚拟化，这就是虚拟存储器。",
        "offset": 45913463,
        "duration": 39903847
      },
      {
        "type": "SentenceBoundary",
        "text": "它在物理内存和磁盘之间，造出一个更大的抽象空间。",
        "offset": 85817310,
        "duration": 43750001
      },
      {
        "type": "SentenceBoundary",
        "text": "程序看到的是连续、完整的一段地址空间。",
        "offset": 129567312,
        "duration": 42788463
      },
      {
        "type": "SentenceBoundary",
        "text": "实际这些地址可能分散在内存各处，甚至根本不在内存里。",
        "offset": 172355775,
        "duration": 52043271
      },
      {
        "type": "SentenceBoundary",
        "text": "把逻辑地址空间和物理内存解耦，这是设计的核心。",
        "offset": 224399046,
        "duration": 42908655
      },
      {
        "type": "SentenceBoundary",
        "text": "这一期拆成四个问题：怎么划分、怎么翻译、怎么查表、怎么访存。",
        "offset": 267307702,
        "duration": 61899040
      },
      {
        "type": "SentenceBoundary",
        "text": "先看两种内存到底差在哪。",
        "offset": 329206742,
        "duration": 30528847
      }
    ],
