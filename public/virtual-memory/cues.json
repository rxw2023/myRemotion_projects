  "s12": {
    "duration": 39.72,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "现在说缺页。",
        "offset": 1000000,
        "duration": 15846154
      },
      {
        "type": "SentenceBoundary",
        "text": "MMU 查到页表项，valid 为零，翻译进行不下去。",
        "offset": 16346154,
        "duration": 46394232
      },
      {
        "type": "SentenceBoundary",
        "text": "这时触发一个异常，交给内核处理，这就是缺页中断。",
        "offset": 62740386,
        "duration": 47716347
      },
      {
        "type": "SentenceBoundary",
        "text": "内核先判断原因：是没分配，是被换出到磁盘，还是非法访问。",
        "offset": 110456734,
        "duration": 58413463
      },
      {
        "type": "SentenceBoundary",
        "text": "非法访问直接终止进程，就是常见的段错误。",
        "offset": 168870198,
        "duration": 42908655
      },
      {
        "type": "SentenceBoundary",
        "text": "合法的缺页，得找一个物理页框。",
        "offset": 211778853,
        "duration": 29326924
      },
      {
        "type": "SentenceBoundary",
        "text": "有空闲的就直接用；没有就按置换算法挑一页换出去。",
        "offset": 241105778,
        "duration": 54206732
      },
      {
        "type": "SentenceBoundary",
        "text": "然后从磁盘把这一页读进来，更新页表，把 valid 置一。",
        "offset": 295312510,
        "duration": 49278847
      },
      {
        "type": "SentenceBoundary",
        "text": "最后回到那条指令，重新执行一次，这次就能翻译成功了。",
        "offset": 344591358,
        "duration": 52043271
      }
    ],
