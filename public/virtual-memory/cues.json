  "s10": {
    "duration": 42.936,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "页表在内存里，翻译一次至少多一次访存。",
        "offset": 1000000,
        "duration": 38442309
      },
      {
        "type": "SentenceBoundary",
        "text": "多级页表更惨，四级的要访存四次。",
        "offset": 38942309,
        "duration": 34975962
      },
      {
        "type": "SentenceBoundary",
        "text": "于是 CPU 里加了一个小缓存，专门存最近的翻译结果，TLB。",
        "offset": 73918271,
        "duration": 54567309
      },
      {
        "type": "SentenceBoundary",
        "text": "它按行组织，每行有 tag，有物理页号，还有有效位。",
        "offset": 128485581,
        "duration": 46995194
      },
      {
        "type": "SentenceBoundary",
        "text": "查找方式和 cache 一模一样：直接映射、全相联、组相联。",
        "offset": 175480775,
        "duration": 54807694
      },
      {
        "type": "SentenceBoundary",
        "text": "用 VPN 的低几位选行或者选组，高位当 tag 去比对。",
        "offset": 230288469,
        "duration": 46875001
      },
      {
        "type": "SentenceBoundary",
        "text": "直接映射时，匹配字段是行号；全相联时，匹配字段是零位。",
        "offset": 277163471,
        "duration": 59014425
      },
      {
        "type": "SentenceBoundary",
        "text": "命中的条件有两个：valid 为一，tag 相同。",
        "offset": 336177896,
        "duration": 42427886
      },
      {
        "type": "SentenceBoundary",
        "text": "命中就直接拿到物理页号；没命中，才去查页表。",
        "offset": 378605783,
        "duration": 50120194
      }
    ],
