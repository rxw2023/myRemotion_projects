  "s11": {
    "duration": 30.456,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "TLB 和 cache 经常被放在一起考，别混。",
        "offset": 1000000,
        "duration": 36639424
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 存的是物理页号，也就是映射关系。",
        "offset": 37139424,
        "duration": 34735578
      },
      {
        "type": "SentenceBoundary",
        "text": "cache 存的是主存里的数据块，是真正的内容。",
        "offset": 71875002,
        "duration": 35216347
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 用虚拟页号去查。",
        "offset": 107091350,
        "duration": 25000000
      },
      {
        "type": "SentenceBoundary",
        "text": "cache 用物理地址里的主存块号去查。",
        "offset": 132091350,
        "duration": 30288462
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 只在地址翻译时用；cache 在拿到物理地址之后用。",
        "offset": 162379813,
        "duration": 50120194
      },
      {
        "type": "SentenceBoundary",
        "text": "一句话对位：TLB 对页表，好比 cache 对主存。",
        "offset": 212500007,
        "duration": 43149040
      },
      {
        "type": "SentenceBoundary",
        "text": "两者都是硬件，都在 MMU 附近，只是分工不同。",
        "offset": 255649047,
        "duration": 48317309
      }
    ],
