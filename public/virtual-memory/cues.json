  "s16": {
    "duration": 38.952,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "考大题最爱问：一共访存几次。",
        "offset": 1000000,
        "duration": 30990385
      },
      {
        "type": "SentenceBoundary",
        "text": "按两条线数：翻译几次，取数几次。",
        "offset": 31490385,
        "duration": 38341347
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 命中，翻译零次访存。",
        "offset": 69831733,
        "duration": 29326924
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 没命中，查一级页表算一次，几级就几次。",
        "offset": 99158657,
        "duration": 45072117
      },
      {
        "type": "SentenceBoundary",
        "text": "取数时 cache 命中，算一次访存；没命中，再加一次主存。",
        "offset": 144230774,
        "duration": 52163463
      },
      {
        "type": "SentenceBoundary",
        "text": "所以最常见的那组答案：TLB 命中加 cache 命中，总共一次。",
        "offset": 196394237,
        "duration": 51802886
      },
      {
        "type": "SentenceBoundary",
        "text": "TLB 没命中、单级页表、cache 命中，总共两次。",
        "offset": 248197124,
        "duration": 44831732
      },
      {
        "type": "SentenceBoundary",
        "text": "如果缺页，还要再加一次磁盘读，脏页换出再加一次写。",
        "offset": 293028856,
        "duration": 51562501
      },
      {
        "type": "SentenceBoundary",
        "text": "数的时候别漏了页表本身也在内存里这件事。",
        "offset": 344591358,
        "duration": 44350963
      }
    ],
