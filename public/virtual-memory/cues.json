  "s06": {
    "duration": 49.44,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "来算一道最典型的题。",
        "offset": 1000000,
        "duration": 21014423
      },
      {
        "type": "SentenceBoundary",
        "text": "虚拟内存十六 MB，物理内存一 MB，页面四 KB。",
        "offset": 21514423,
        "duration": 48918271
      },
      {
        "type": "SentenceBoundary",
        "text": "先看偏移：四 KB 是二的十二次方，所以偏移十二位。",
        "offset": 70432694,
        "duration": 51923078
      },
      {
        "type": "SentenceBoundary",
        "text": "虚拟地址总位数，十六 MB 是二的二十四次方，二十四位。",
        "offset": 122355773,
        "duration": 55288463
      },
      {
        "type": "SentenceBoundary",
        "text": "物理地址一 MB，二十位。",
        "offset": 177644237,
        "duration": 28365385
      },
      {
        "type": "SentenceBoundary",
        "text": "那 VPN 就是二十四减十二，十二位；PPN 是二十减十二，八位。",
        "offset": 206009622,
        "duration": 61778848
      },
      {
        "type": "SentenceBoundary",
        "text": "现在翻译地址 0x321654。",
        "offset": 267788471,
        "duration": 41466347
      },
      {
        "type": "SentenceBoundary",
        "text": "低十二位 0x654 是页内偏移，直接照抄。",
        "offset": 309254819,
        "duration": 47115386
      },
      {
        "type": "SentenceBoundary",
        "text": "高十二位 0x321 是虚拟页号，拿它当页表下标。",
        "offset": 356370205,
        "duration": 48317309
      },
      {
        "type": "SentenceBoundary",
        "text": "查到第 0x321 个页表项，看 valid。",
        "offset": 404687514,
        "duration": 38341347
      },
      {
        "type": "SentenceBoundary",
        "text": "为零就缺页，为一就取出 PPN，和偏移拼成物理地址。",
        "offset": 443028862,
        "duration": 50841348
      }
    ],
    "cues": [
      {
        "text": "来算一道最典型的题。",
        "start": 0.1,
        "end": 2.201
      },
      {
        "text": "虚拟内存十六 MB，物理内存一 MB，页面四 KB。",
        "start": 2.201,
        "end": 7.043
      },
      {
        "text": "先看偏移：四 KB 是二的十二次方，所以偏移十二位。",
        "start": 7.043,
        "end": 12.236
      },
      {
        "text": "虚拟地址总位数，十六 MB 是二的二十四次方，二十四位。",
        "start": 12.236,
        "end": 17.764
      },
      {
        "text": "物理地址一 MB，二十位。",
        "start": 17.764,
        "end": 20.601
      },
      {
        "text": "那 VPN 就是二十四减十二，十二位；PPN 是二十减十二，八位。",
        "start": 20.601,
        "end": 26.779
      },
      {
        "text": "现在翻译地址 0x321654。",
        "start": 26.779,
        "end": 30.925
      },
      {
        "text": "低十二位 0x654 是页内偏移，直接照抄。",
        "start": 30.925,
        "end": 35.637
      },
      {
        "text": "高十二位 0x321 是虚拟页号，拿它当页表下标。",
        "start": 35.637,
        "end": 40.469
      },
      {
        "text": "查到第 0x321 个页表项，看 valid。",
        "start": 40.469,
        "end": 44.303
      },
      {
        "text": "为零就缺页，为一就取出 PPN，和偏移拼成物理地址。",
        "start": 44.303,
        "end": 49.44
      }
    ]
  },
  "s07": {
    "duration": 31.704,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "单级页表有个硬伤：太大。",
        "offset": 1000000,
        "duration": 27985577
      },
      {
        "type": "SentenceBoundary",
        "text": "三十二位地址空间是四 GB，页面四 KB，就有一百万个虚拟页。",
        "offset": 28485577,
        "duration": 57812502
      },
      {
        "type": "SentenceBoundary",
        "text": "每个页表项四字节，页表本身就是四 MB。",
        "offset": 86298080,
        "duration": 41586539
      },
      {
        "type": "SentenceBoundary",
        "text": "四 MB 必须常驻内存，可程序可能只用了几百 KB。",
        "offset": 127884620,
        "duration": 44591347
      },
      {
        "type": "SentenceBoundary",
        "text": "这不划算，而且每个进程都要来一份。",
        "offset": 172475967,
        "duration": 32451924
      },
      {
        "type": "SentenceBoundary",
        "text": "根源在于：虚拟空间大部分是空的，页表却按最大规模一次铺开。",
        "offset": 204927892,
        "duration": 58173079
      },
      {
        "type": "SentenceBoundary",
        "text": "能不能只给用到的部分建页表？",
        "offset": 263100971,
        "duration": 25000000
      },
      {
        "type": "SentenceBoundary",
        "text": "能，这就是多级页表。",
        "offset": 288100972,
        "duration": 28485577
      }
