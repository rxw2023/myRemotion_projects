  "s05": {
    "duration": 39.096,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "页表就是一张映射表，一行叫一个页表项，PTE。",
        "offset": 1000000,
        "duration": 44812501
      },
      {
        "type": "SentenceBoundary",
        "text": "单级页表里，虚拟页号是下标，不需要真的存进去。",
        "offset": 45312501,
        "duration": 44471155
      },
      {
        "type": "SentenceBoundary",
        "text": "所以页表项里最关键的是物理页号，PPN。",
        "offset": 89783657,
        "duration": 42788463
      },
      {
        "type": "SentenceBoundary",
        "text": "还有一个有效位，valid，一表示这个页在内存里。",
        "offset": 132572120,
        "duration": 39302886
      },
      {
        "type": "SentenceBoundary",
        "text": "valid 为零，说明页不在内存，要触发缺页。",
        "offset": 171875006,
        "duration": 41466347
      },
      {
        "type": "SentenceBoundary",
        "text": "修改位 dirty 记这一页有没有被写过，写过换出时要写回磁盘。",
        "offset": 213341353,
        "duration": 55168271
      },
      {
        "type": "SentenceBoundary",
        "text": "访问位 accessed 记有没有被读过，给置换算法用。",
        "offset": 268509625,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "保护位管读写执行权限，缓存位管能不能进 cache。",
        "offset": 311778857,
        "duration": 46033655
      },
      {
        "type": "SentenceBoundary",
        "text": "后面两位考得少，前三个必须看。",
        "offset": 357812513,
        "duration": 32572116
      }
    ],
