  "s09": {
    "duration": 39.96,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "每个进程都有自己的页表，那 MMU 怎么知道用哪一张？",
        "offset": 1000000,
        "duration": 42288463
      },
      {
        "type": "SentenceBoundary",
        "text": "靠一个寄存器：页表基址寄存器，PTBR。",
        "offset": 42788463,
        "duration": 42427886
      },
      {
        "type": "SentenceBoundary",
        "text": "它存的是当前进程顶级页表在物理内存里的起始地址。",
        "offset": 85216349,
        "duration": 46033655
      },
      {
        "type": "SentenceBoundary",
        "text": "注意，存的是物理地址，不是虚拟地址。",
        "offset": 131250004,
        "duration": 39903847
      },
      {
        "type": "SentenceBoundary",
        "text": "每个进程的 PCB 里都记着自己页表的物理基址。",
        "offset": 171153852,
        "duration": 38942309
      },
      {
        "type": "SentenceBoundary",
        "text": "进程切换时，操作系统把新进程的基址写进 PTBR，比如 x86 的 CR3。",
        "offset": 210096161,
        "duration": 70072117
      },
      {
        "type": "SentenceBoundary",
        "text": "从这一刻起，MMU 查的就是新进程的页表。",
        "offset": 280168279,
        "duration": 41225963
      },
      {
        "type": "SentenceBoundary",
        "text": "所以进程切换，本质就是换了一张地址空间的地图。",
        "offset": 321394242,
        "duration": 42307693
      },
      {
        "type": "SentenceBoundary",
        "text": "同一时刻，只有一个 PTBR 生效。",
        "offset": 363701936,
        "duration": 35336539
      }
    ],
