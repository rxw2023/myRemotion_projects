  "s04": {
    "duration": 43.344,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "翻译是谁做的？",
        "offset": 1000000,
        "duration": 16206731
      },
      {
        "type": "SentenceBoundary",
        "text": "CPU 里有个部件叫内存管理单元，MMU。",
        "offset": 16706731,
        "duration": 42548078
      },
      {
        "type": "SentenceBoundary",
        "text": "它干三件事：地址转换、地址保护、访问权限控制。",
        "offset": 59254809,
        "duration": 51562501
      },
      {
        "type": "SentenceBoundary",
        "text": "很多同学会卡在这里：页表是操作系统维护的，翻译却是硬件做的。",
        "offset": 110817311,
        "duration": 57091348
      },
      {
        "type": "SentenceBoundary",
        "text": "这不矛盾，关键在分工。",
        "offset": 167908660,
        "duration": 26081731
      },
      {
        "type": "SentenceBoundary",
        "text": "操作系统提供规则和数据，硬件执行翻译过程。",
        "offset": 193990391,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "页表的层级、每一位的含义，都由 CPU 架构规范定死。",
        "offset": 237259624,
        "duration": 49038463
      },
      {
        "type": "SentenceBoundary",
        "text": "操作系统只是照着规范，在内存里把页表搭出来。",
        "offset": 286298087,
        "duration": 44230770
      },
      {
        "type": "SentenceBoundary",
        "text": "真正的翻译，是 MMU 按当前页表基址，一级一级查出来的。",
        "offset": 330528858,
        "duration": 57451925
      },
      {
        "type": "SentenceBoundary",
        "text": "对软件完全透明，不需要操作系统逐条参与。",
        "offset": 387980783,
        "duration": 44951924
      }
    ],
