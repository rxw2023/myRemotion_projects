  "s03": {
    "duration": 35.4,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "页式管理的地址，结构特别规整。",
        "offset": 1000000,
        "duration": 32192308
      },
      {
        "type": "SentenceBoundary",
        "text": "虚拟地址分成两段：前面是虚拟页号，后面是页内偏移。",
        "offset": 32692308,
        "duration": 51081732
      },
      {
        "type": "SentenceBoundary",
        "text": "物理地址也分成两段：物理页号，加页内偏移。",
        "offset": 83774041,
        "duration": 44951924
      },
      {
        "type": "SentenceBoundary",
        "text": "关键的一点：两边的偏移完全相同，一个位都不差。",
        "offset": 128725966,
        "duration": 46153847
      },
      {
        "type": "SentenceBoundary",
        "text": "所以地址翻译，只需要把虚拟页号换成物理页号。",
        "offset": 174879814,
        "duration": 41586539
      },
      {
        "type": "SentenceBoundary",
        "text": "页大小是二的偏移位数次方，虚页数是二的 VPN 位数次方。",
        "offset": 216466354,
        "duration": 56370194
      },
      {
        "type": "SentenceBoundary",
        "text": "再记两个同义词：虚拟页又叫逻辑页，页框就是物理页。",
        "offset": 272836548,
        "duration": 51201924
      },
      {
        "type": "SentenceBoundary",
        "text": "考试里换着叫，别被绕晕。",
        "offset": 324038473,
        "duration": 29447116
      }
    ],
