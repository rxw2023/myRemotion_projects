  "s13": {
    "duration": 36.384,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "这种按需调页的策略，叫请求页式管理。",
        "offset": 1000000,
        "duration": 38322116
      },
      {
        "type": "SentenceBoundary",
        "text": "进程启动时，一页都不装，访问到才装。",
        "offset": 38822116,
        "duration": 39783655
      },
      {
        "type": "SentenceBoundary",
        "text": "所以叫懒加载。",
        "offset": 78605772,
        "duration": 15384615
      },
      {
        "type": "SentenceBoundary",
        "text": "和它对应的是预调页：运行前先装一部分甚至全部。",
        "offset": 93990388,
        "duration": 43990386
      },
      {
        "type": "SentenceBoundary",
        "text": "考研语境下说虚拟存储，默认就是请求页式。",
        "offset": 137980774,
        "duration": 40985578
      },
      {
        "type": "SentenceBoundary",
        "text": "再说一个容易误解的点：缺页之后不一定就要置换。",
        "offset": 178966352,
        "duration": 42187501
      },
      {
        "type": "SentenceBoundary",
        "text": "缺页的本质是页表项 valid 为零，映射不完整。",
        "offset": 221153854,
        "duration": 43269232
      },
      {
        "type": "SentenceBoundary",
        "text": "内核要做的是把映射补上：分配页框、读磁盘、改页表都可能。",
        "offset": 264423086,
        "duration": 60697117
      },
      {
        "type": "SentenceBoundary",
        "text": "教材那句缺页就换页，是简化过的模型。",
        "offset": 325120204,
        "duration": 38221155
      }
    ],
