  "s12": {
    "duration": 34.416,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "浮点加减，四步：对阶、尾数运算、规格化、舍入。",
        "offset": 1000000,
        "duration": 58514425
      },
      {
        "type": "SentenceBoundary",
        "text": "对阶原则是：小阶向大阶看齐。",
        "offset": 59014425,
        "duration": 34375001
      },
      {
        "type": "SentenceBoundary",
        "text": "小阶的尾数右移，阶码变大。",
        "offset": 93389426,
        "duration": 30769231
      },
      {
        "type": "SentenceBoundary",
        "text": "对阶只丢精度，不会引起阶码溢出。",
        "offset": 124158658,
        "duration": 31610578
      },
      {
        "type": "SentenceBoundary",
        "text": "尾数运算后可能进位，要右规，阶码加一，可能上溢。",
        "offset": 155769236,
        "duration": 51682694
      },
      {
        "type": "SentenceBoundary",
        "text": "尾数太小要左规，阶码减一，可能下溢。",
        "offset": 207451930,
        "duration": 37860578
      },
      {
        "type": "SentenceBoundary",
        "text": "最后舍入，舍入进位后还要再右规一次。",
        "offset": 245312508,
        "duration": 38461539
      },
      {
        "type": "SentenceBoundary",
        "text": "记住：尾数溢出不等于结果溢出，只看最终阶码有没有越界。",
        "offset": 283774048,
        "duration": 59855771
      }
    ],
