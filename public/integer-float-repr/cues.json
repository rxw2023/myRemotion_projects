  "s05": {
    "duration": 31.2,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "给定一个负数求补码，两步：取反，加一。",
        "offset": 1000000,
        "duration": 44211540
      },
      {
        "type": "SentenceBoundary",
        "text": "先写出它绝对值的纯二进制。",
        "offset": 44711540,
        "duration": 27043270
      },
      {
        "type": "SentenceBoundary",
        "text": "负七十三的绝对值是七十三，零一零零一零零一。",
        "offset": 71754810,
        "duration": 42908655
      },
      {
        "type": "SentenceBoundary",
        "text": "按位取反，变成一零一一零一零。",
        "offset": 114663465,
        "duration": 30769231
      },
      {
        "type": "SentenceBoundary",
        "text": "再加一，得到一零一一零一一一。",
        "offset": 145432697,
        "duration": 28725962
      },
      {
        "type": "SentenceBoundary",
        "text": "为什么叫二的补码？",
        "offset": 174158660,
        "duration": 16947116
      },
      {
        "type": "SentenceBoundary",
        "text": "本质是用二的八次方减去七十三。",
        "offset": 191105776,
        "duration": 31250001
      },
      {
        "type": "SentenceBoundary",
        "text": "在模运算里，减法就变成了加法。",
        "offset": 222355777,
        "duration": 31370193
      },
      {
        "type": "SentenceBoundary",
        "text": "所以加减法共用一套加法器，这是补码最大的工程价值。",
        "offset": 253725970,
        "duration": 57812502
      }
    ],
