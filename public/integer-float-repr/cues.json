  "s01": {
    "duration": 26.28,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "先分清两个概念：字面值，和二进制位。",
        "offset": 1000000,
        "duration": 41206732
      },
      {
        "type": "SentenceBoundary",
        "text": "字面值是我们写在纸上的负七十三，带正负号。",
        "offset": 41706732,
        "duration": 46274040
      },
      {
        "type": "SentenceBoundary",
        "text": "二进制位，是机器里真正存的一串零和一。",
        "offset": 87980772,
        "duration": 39423078
      },
      {
        "type": "SentenceBoundary",
        "text": "原码、补码、无符号数，不是三种不同的数据。",
        "offset": 127403850,
        "duration": 43629809
      },
      {
        "type": "SentenceBoundary",
        "text": "它们是对同一组比特的三种解释规则。",
        "offset": 171033660,
        "duration": 31370193
      },
      {
        "type": "SentenceBoundary",
        "text": "所以关键不是这串位是什么，而是编译器用哪套规则读它。",
        "offset": 202403853,
        "duration": 59855771
      }
    ],
