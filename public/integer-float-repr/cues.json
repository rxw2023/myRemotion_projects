  "s02": {
    "duration": 27.192,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "先看最简单的：无符号数，也就是纯二进制。",
        "offset": 1000000,
        "duration": 43129809
      },
      {
        "type": "SentenceBoundary",
        "text": "第 i 位的权重，是二的 i 次方。",
        "offset": 43629809,
        "duration": 31610578
      },
      {
        "type": "SentenceBoundary",
        "text": "从右往左，一、二、四、八，一路翻倍。",
        "offset": 75240387,
        "duration": 49879809
      },
      {
        "type": "SentenceBoundary",
        "text": "每一位乘以权重再求和，就得到数值。",
        "offset": 125120196,
        "duration": 34855770
      },
      {
        "type": "SentenceBoundary",
        "text": "八个位里，最高位的权重是一百二十八。",
        "offset": 159975967,
        "duration": 36177885
      },
      {
        "type": "SentenceBoundary",
        "text": "一后面六个零再加一个一，等于一百二十九。",
        "offset": 196153853,
        "duration": 37860578
      },
      {
        "type": "SentenceBoundary",
        "text": "八位无符号的范围，是零到二百五十五。",
        "offset": 234014431,
        "duration": 37379809
      }
    ],
