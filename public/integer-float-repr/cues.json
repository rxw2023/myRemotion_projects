  "s07": {
    "duration": 31.608,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "整数说完了，实数怎么办？",
        "offset": 1000000,
        "duration": 27504808
      },
      {
        "type": "SentenceBoundary",
        "text": "最直接的方案是定点数。",
        "offset": 28004808,
        "duration": 23317308
      },
      {
        "type": "SentenceBoundary",
        "text": "约定某一位是小数点，左边整数，右边小数。",
        "offset": 51322117,
        "duration": 42427886
      },
      {
        "type": "SentenceBoundary",
        "text": "小数点右边，权重是二分之一、四分之一、八分之一。",
        "offset": 93750003,
        "duration": 50240386
      },
      {
        "type": "SentenceBoundary",
        "text": "但小数点位置固定，范围就被锁死了。",
        "offset": 143990389,
        "duration": 36418270
      },
      {
        "type": "SentenceBoundary",
        "text": "要表示二的负一百零二次方这种量级，得写一百多个位。",
        "offset": 180408660,
        "duration": 51322117
      },
      {
        "type": "SentenceBoundary",
        "text": "其中绝大部分还是零，位被白白浪费。",
        "offset": 231730777,
        "duration": 39423078
      },
      {
        "type": "SentenceBoundary",
        "text": "于是有了浮点数，本质是二进制的科学计数法。",
        "offset": 271153856,
        "duration": 44471155
      }
