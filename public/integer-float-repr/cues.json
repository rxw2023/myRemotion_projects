  "s08": {
    "duration": 41.472,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "IEEE 七五四标准，把浮点数拆成三段。",
        "offset": 1000000,
        "duration": 40245193
      },
      {
        "type": "SentenceBoundary",
        "text": "符号位 s，阶码 E，尾数 M。",
        "offset": 40745193,
        "duration": 33413462
      },
      {
        "type": "SentenceBoundary",
        "text": "值等于负一的 s 次方，乘一点几，再乘二的 E 减偏置次方。",
        "offset": 74158656,
        "duration": 52764425
      },
      {
        "type": "SentenceBoundary",
        "text": "单精度三十二位：一、八、二十三，偏置一百二十七。",
        "offset": 126923081,
        "duration": 52524040
      },
      {
        "type": "SentenceBoundary",
        "text": "双精度六十四位：一、十一、五十二，偏置一千零二十三。",
        "offset": 179447121,
        "duration": 58533655
      },
      {
        "type": "SentenceBoundary",
        "text": "为什么要加偏置？",
        "offset": 237980777,
        "duration": 17668269
      },
      {
        "type": "SentenceBoundary",
        "text": "因为阶码要表示负指数，可它按无符号存。",
        "offset": 255649047,
        "duration": 42187501
      },
      {
        "type": "SentenceBoundary",
        "text": "加偏置把所有指数平移成正数，比大小就是比二进制。",
        "offset": 297836549,
        "duration": 52283655
      },
      {
        "type": "SentenceBoundary",
        "text": "还有个便宜：规格化后尾数总是一点几，那个一不存，白赚一位。",
        "offset": 350120205,
        "duration": 63942310
      }
    ],
