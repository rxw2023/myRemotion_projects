  "s03": {
    "duration": 28.08,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "反过来，十进制转二进制用除二取余。",
        "offset": 1000000,
        "duration": 37841347
      },
      {
        "type": "SentenceBoundary",
        "text": "以七十三为例，连续除以二，记下每次的余数。",
        "offset": 38341347,
        "duration": 43990386
      },
      {
        "type": "SentenceBoundary",
        "text": "七十三除二余一，三十六除二余零。",
        "offset": 82331733,
        "duration": 34615385
      },
      {
        "type": "SentenceBoundary",
        "text": "十八除二余零，九除二余一。",
        "offset": 116947119,
        "duration": 30889424
      },
      {
        "type": "SentenceBoundary",
        "text": "四、二、一依次除下去，商到零就停。",
        "offset": 147836543,
        "duration": 45312501
      },
      {
        "type": "SentenceBoundary",
        "text": "余数从下往上倒着读，就是零一零零一零零一。",
        "offset": 193149045,
        "duration": 42788463
      },
      {
        "type": "SentenceBoundary",
        "text": "熟练之后可以直接凑二的幂：六十四加八加一。",
        "offset": 235937508,
        "duration": 44350963
      }
    ],
