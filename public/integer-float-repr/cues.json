  "s10": {
    "duration": 31.128,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "阶码不是随便取的，它决定浮点数的四种身份。",
        "offset": 1000000,
        "duration": 39283655
      },
      {
        "type": "SentenceBoundary",
        "text": "阶码既不全零也不全一，是正常值，用隐含的一。",
        "offset": 39783655,
        "duration": 50600963
      },
      {
        "type": "SentenceBoundary",
        "text": "阶码全零，是非正常值：没有隐含的一。",
        "offset": 90384618,
        "duration": 38701924
      },
      {
        "type": "SentenceBoundary",
        "text": "指数固定成一减偏置，尾数全零就是零。",
        "offset": 129086543,
        "duration": 42067309
      },
      {
        "type": "SentenceBoundary",
        "text": "阶码全一、尾数全零，是正无穷或负无穷。",
        "offset": 171153852,
        "duration": 47956732
      },
      {
        "type": "SentenceBoundary",
        "text": "阶码全一、尾数非零，是非数字 NaN。",
        "offset": 219110584,
        "duration": 36899039
      },
      {
        "type": "SentenceBoundary",
        "text": "非正常值的意义，是在最小正常数和零之间铺一条过渡带。",
        "offset": 256009624,
        "duration": 54687502
      }
    ],
