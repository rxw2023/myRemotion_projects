  "s07": {
    "duration": 28.296,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "乘法本质是移位相加。",
        "offset": 1000000,
        "duration": 27504808
      },
      {
        "type": "SentenceBoundary",
        "text": "手算一一零一乘一一一零，是四次部分积错位排好再求和。",
        "offset": 28004808,
        "duration": 50480771
      },
      {
        "type": "SentenceBoundary",
        "text": "没有硬件支持时，编译器用循环：看最低位，是就加，再移位。",
        "offset": 78485579,
        "duration": 63822117
      },
      {
        "type": "SentenceBoundary",
        "text": "顺序乘法器就是这么做的，一个周期出一位结果。",
        "offset": 142307697,
        "duration": 42187501
      },
      {
        "type": "SentenceBoundary",
        "text": "阵列乘法器把全加器铺成二维网格，所有部分积同时算。",
        "offset": 184495199,
        "duration": 55408655
      },
      {
        "type": "SentenceBoundary",
        "text": "用面积换时间，这是硬件里最经典的一笔交易。",
        "offset": 239903854,
        "duration": 42548078
      }
    ],
