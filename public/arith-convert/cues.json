  "s03": {
    "duration": 22.032,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "把 n 个全加器串起来，就是 n 位加法器。",
        "offset": 1000000,
        "duration": 38322116
      },
      {
        "type": "SentenceBoundary",
        "text": "每一位的进位输出，接到下一位的进位输入。",
        "offset": 38822116,
        "duration": 39663462
      },
      {
        "type": "SentenceBoundary",
        "text": "这叫行波进位，进位像波纹一样从最低位爬到最高位。",
        "offset": 78485579,
        "duration": 50000001
      },
      {
        "type": "SentenceBoundary",
        "text": "延迟逐级累加，位数越多，最高位等得越久。",
        "offset": 128485581,
        "duration": 42788463
      },
      {
        "type": "SentenceBoundary",
        "text": "所以加法看着最简单，却常常是时序上的瓶颈。",
        "offset": 171274044,
        "duration": 48437501
      }
    ],
    "cues": [
