  "s06": {
    "duration": 28.608,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "有了全加器，减法就不需要单独的电路。",
        "offset": 1000000,
        "duration": 36038462
      },
      {
        "type": "SentenceBoundary",
        "text": "A 减 B，等于 A 加 B 的补码，也就是取反再加一。",
        "offset": 36538462,
        "duration": 46033655
      },
      {
        "type": "SentenceBoundary",
        "text": "所以在 B 前面加一排异或门，用 Sub 做开关。",
        "offset": 82572118,
        "duration": 47355770
      },
      {
        "type": "SentenceBoundary",
        "text": "Sub 等于零，B 原样通过；等于一，B 每一位都取反。",
        "offset": 129927889,
        "duration": 50600963
      },
      {
        "type": "SentenceBoundary",
        "text": "同时把 Sub 接到最低位的进位输入，加一也顺手完成。",
        "offset": 180528852,
        "duration": 49639424
      },
      {
        "type": "SentenceBoundary",
        "text": "一个加法器通吃加减，代价是减法下 CF 变成了借位。",
        "offset": 230168277,
        "duration": 55408655
      }
    ],
