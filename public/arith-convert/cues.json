  "s04": {
    "duration": 25.704,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "同一个加法器，既能算无符号数，也能算补码。",
        "offset": 1000000,
        "duration": 44812501
      },
      {
        "type": "SentenceBoundary",
        "text": "因为电路只认零和一，它不知道你在算什么类型。",
        "offset": 45312501,
        "duration": 39543270
      },
      {
        "type": "SentenceBoundary",
        "text": "一一一一加一，无符号是一百二十八加一，得一百二十九。",
        "offset": 84855772,
        "duration": 43990386
      },
      {
        "type": "SentenceBoundary",
        "text": "补码里，它是负一加一，得零，还留下一个进位。",
        "offset": 128846158,
        "duration": 44471155
      },
      {
        "type": "SentenceBoundary",
        "text": "位模式一样，只是解释规则不同。",
        "offset": 173317314,
        "duration": 29807693
      },
      {
        "type": "SentenceBoundary",
        "text": "运算电路不区分类型，区分类型的是标志位和指令。",
        "offset": 203125007,
        "duration": 53365386
      }
    ],
