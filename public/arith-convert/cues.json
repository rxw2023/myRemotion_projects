  "s05": {
    "duration": 31.152,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "有符号运算，需要四个标志位说明结果的性质。",
        "offset": 1000000,
        "duration": 42168270
      },
      {
        "type": "SentenceBoundary",
        "text": "ZF 零标志：结果每一位都是零，它就置一。",
        "offset": 42668270,
        "duration": 43750001
      },
      {
        "type": "SentenceBoundary",
        "text": "SF 符号标志：直接取结果的最高位。",
        "offset": 86418272,
        "duration": 34615385
      },
      {
        "type": "SentenceBoundary",
        "text": "CF 进位标志：加法取最高位进位，减法取借位。",
        "offset": 121033658,
        "duration": 51322117
      },
      {
        "type": "SentenceBoundary",
        "text": "OF 溢出标志：最高位进位，异或次高位进位。",
        "offset": 172355775,
        "duration": 46153847
      },
      {
        "type": "SentenceBoundary",
        "text": "为什么是异或？",
        "offset": 218509623,
        "duration": 15865385
      },
      {
        "type": "SentenceBoundary",
        "text": "只有一进一出不一致，符号才被真的顶翻。",
        "offset": 234375008,
        "duration": 36538462
      },
      {
        "type": "SentenceBoundary",
        "text": "正加正得负，负加负得正，都是溢出。",
        "offset": 270913471,
        "duration": 40024039
      }
    ],
