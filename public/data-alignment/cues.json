  "s02": {
    "duration": 31.392,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "对齐因子多大，由数据类型的大小决定。",
        "offset": 1000000,
        "duration": 36764152
      },
      {
        "type": "SentenceBoundary",
        "text": "基本规律一句话：对齐因子等于类型自身的字节数。",
        "offset": 37264152,
        "duration": 48584908
      },
      {
        "type": "SentenceBoundary",
        "text": "char 一字节，因子一，任何地址都能放。",
        "offset": 85849061,
        "duration": 37971700
      },
      {
        "type": "SentenceBoundary",
        "text": "short 两字节，地址必须是二的倍数。",
        "offset": 123820761,
        "duration": 35613209
      },
      {
        "type": "SentenceBoundary",
        "text": "int 和 float 四字节，地址是四的倍数。",
        "offset": 159433970,
        "duration": 36674530
      },
      {
        "type": "SentenceBoundary",
        "text": "double 和 long long 八字节，地址是八的倍数。",
        "offset": 196108501,
        "duration": 38797171
      },
      {
        "type": "SentenceBoundary",
        "text": "六十四位系统里，指针也是八。",
        "offset": 234905673,
        "duration": 29245284
      },
      {
        "type": "SentenceBoundary",
        "text": "但有个上限：对齐因子不会超过硬件的最大对齐限制。",
        "offset": 264150957,
        "duration": 49292455
      }
    ],
