  "s01": {
    "duration": 23.496,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "这个规矩，叫数据对齐。",
        "offset": 1000000,
        "duration": 25443397
      },
      {
        "type": "SentenceBoundary",
        "text": "它要求数据的起始地址，必须是某个数的整数倍。",
        "offset": 25943397,
        "duration": 43160379
      },
      {
        "type": "SentenceBoundary",
        "text": "这个数，叫对齐因子。",
        "offset": 69103777,
        "duration": 23349057
      },
      {
        "type": "SentenceBoundary",
        "text": "写成公式就是：起始地址对 K 取余，等于零。",
        "offset": 92452835,
        "duration": 43632077
      },
      {
        "type": "SentenceBoundary",
        "text": "换成二进制看更直接：地址的低几位必须全是零。",
        "offset": 136084913,
        "duration": 48231134
      },
      {
        "type": "SentenceBoundary",
        "text": "对齐因子是四，低两位为零；是八，低三位为零。",
        "offset": 184316047,
        "duration": 50000002
      }
    ],
    "cues": [
