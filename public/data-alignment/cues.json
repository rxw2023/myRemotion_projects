  "s00": {
    "duration": 16.968,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "先看一个现象：同样是一个 int，为什么有的地址能放，有的不能？",
        "offset": 1000000,
        "duration": 56457550
      },
      {
        "type": "SentenceBoundary",
        "text": "编译器给它的地址，一定能被四整除。",
        "offset": 56957550,
        "duration": 33608492
      },
      {
        "type": "SentenceBoundary",
        "text": "不是巧合，这是硬件定下的规矩。",
        "offset": 90566042,
        "duration": 32193397
      },
      {
        "type": "SentenceBoundary",
        "text": "这一期只讲一件事：数据在内存里，为什么要对齐。",
        "offset": 122759440,
        "duration": 46344342
      }
    ],
    "cues": [
