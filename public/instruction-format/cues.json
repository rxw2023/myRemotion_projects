  "s00": {
    "duration": 17.472,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "一条指令，说到底就一句话：对什么数据，做什么操作。",
        "offset": 1000000,
        "duration": 49617927
      },
      {
        "type": "SentenceBoundary",
        "text": "所以它被切成两部分：操作码，和地址。",
        "offset": 50117927,
        "duration": 41037738
      },
      {
        "type": "SentenceBoundary",
        "text": "操作码决定做什么，地址决定对谁做。",
        "offset": 91155665,
        "duration": 36792454
      },
      {
        "type": "SentenceBoundary",
        "text": "这一期，先把格式拆开，再把八种寻址方式走一遍。",
        "offset": 127948120,
        "duration": 46226417
      }
    ],
