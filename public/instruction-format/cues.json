{
  "s02": {
    "duration": 37.392,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "按操作码分类，指令有七大类。",
        "offset": 1000000,
        "duration": 30985850
      },
      {
        "type": "SentenceBoundary",
        "text": "第一类，数据传输：MOV 搬运，PUSH 入栈，POP 出栈。",
        "offset": 31485850,
        "duration": 52476417
      },
      {
        "type": "SentenceBoundary",
        "text": "第二类，算术逻辑：加减乘除，与或非，还有 CMP 比较。",
        "offset": 83962268,
        "duration": 57900946
      },
      {
        "type": "SentenceBoundary",
        "text": "第三类，控制转移：JMP 无条件跳转，Jxx 条件跳转，CALL 调用，RET 返回。",
        "offset": 141863215,
        "duration": 83962268
      },
      {
        "type": "SentenceBoundary",
        "text": "第四类，输入输出：IN 读端口，OUT 写端口。",
        "offset": 225825483,
        "duration": 45636794
      },
      {
        "type": "SentenceBoundary",
        "text": "剩下三类比较边缘：字符串操作、陷阱指令、协处理器指令。",
        "offset": 271462278,
        "duration": 59905663
      },
      {
        "type": "SentenceBoundary",
        "text": "记住前三类就够用了，考场上的题九成在这里。",
        "offset": 331367942,
        "duration": 42099058
      }
    ],
