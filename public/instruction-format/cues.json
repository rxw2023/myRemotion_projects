  "s07": {
    "duration": 72.0,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "来看真题。",
        "offset": 1000000,
        "duration": 14594340
      },
      {
        "type": "SentenceBoundary",
        "text": "指令长十六位，操作码四位，地址码四位。",
        "offset": 15094340,
        "duration": 41509436
      },
      {
        "type": "SentenceBoundary",
        "text": "要求做出：三地址十五条，二地址十二条，一地址六十三条，零地址十六条。",
        "offset": 56603776,
        "duration": 70990569
      },
      {
        "type": "SentenceBoundary",
        "text": "先看三地址。",
        "offset": 127594346,
        "duration": 16981132
      },
      {
        "type": "SentenceBoundary",
        "text": "四位操作码有十六个编码，用掉十五个，从 0000 到 1110。",
        "offset": 144575479,
        "duration": 64622644
      },
      {
        "type": "SentenceBoundary",
        "text": "只剩 1111 这一个前缀，拿它去扩。",
        "offset": 209198124,
        "duration": 38207549
      },
      {
        "type": "SentenceBoundary",
        "text": "三地址后面跟三个地址，二地址只用两个，所以二地址的操作码是八位。",
        "offset": 247405673,
        "duration": 65801890
      },
      {
        "type": "SentenceBoundary",
        "text": "1111 后面还有四位，共十六个编码，用掉十二个：从 1111 0000 到 1111 1011。",
