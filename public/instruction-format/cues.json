  "s03": {
    "duration": 31.608,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "换个维度分，看一条指令里写了几个地址。",
        "offset": 1000000,
        "duration": 38768870
      },
      {
        "type": "SentenceBoundary",
        "text": "零地址指令，只写操作码。",
        "offset": 39268870,
        "duration": 27830190
      },
      {
        "type": "SentenceBoundary",
        "text": "操作数藏在栈顶，靠 PUSH 和 POP 供给。",
        "offset": 67099060,
        "duration": 37617926
      },
      {
        "type": "SentenceBoundary",
        "text": "一地址指令，写一个地址，它既是源也是目的。",
        "offset": 104716986,
        "duration": 42924530
      },
      {
        "type": "SentenceBoundary",
        "text": "二地址指令最常见：A1 和 A2 运算，结果写回 A1。",
        "offset": 147641517,
        "duration": 52004719
      },
      {
        "type": "SentenceBoundary",
        "text": "三地址指令多一个目的地址，结果写进 A3，不破坏源操作数。",
        "offset": 199646237,
        "duration": 57665097
      },
      {
        "type": "SentenceBoundary",
        "text": "还有四地址指令，多存一个下条指令的地址，现代机器已经不用了。",
        "offset": 257311334,
        "duration": 58136795
      }
    ],
