  "s04": {
    "duration": 28.608,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "指令的长度怎么定，是两条完全不同的路。",
        "offset": 1000000,
        "duration": 37471700
      },
      {
        "type": "SentenceBoundary",
        "text": "定长：所有指令一样长，代表是 ARM 这类 RISC。",
        "offset": 37971700,
        "duration": 42570757
      },
      {
        "type": "SentenceBoundary",
        "text": "解码简单，取指一步到位，代价是有时在浪费空间。",
        "offset": 80542457,
        "duration": 51533021
      },
      {
        "type": "SentenceBoundary",
        "text": "变长：不同指令不同长度，代表是 x86，属于 CISC。",
        "offset": 132075478,
        "duration": 59905663
      },
      {
        "type": "SentenceBoundary",
        "text": "编码紧凑，能塞下复杂操作，代价是指令边界不好找。",
        "offset": 191981142,
        "duration": 54363210
      },
      {
        "type": "SentenceBoundary",
        "text": "这两种设计，各自引出一个必考的变形问题。",
        "offset": 246344352,
        "duration": 39150945
      }
    ],
