  "s03": {
    "duration": 42.984,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "第二个问题：数据在路上坏掉了，怎么知道？",
        "offset": 1000000,
        "duration": 39948115
      },
      {
        "type": "SentenceBoundary",
        "text": "UDP 有校验和，但它只做一件事：发现错误，不负责纠正。",
        "offset": 40448115,
        "duration": 56485852
      },
      {
        "type": "SentenceBoundary",
        "text": "校验的范围不止 UDP 自己，还包括一个假的头部，叫伪首部。",
        "offset": 96933967,
        "duration": 54245285
      },
      {
        "type": "SentenceBoundary",
        "text": "伪首部十二个字节：源 IP 四字节，目的 IP 四字节。",
        "offset": 151179253,
        "duration": 52830191
      },
      {
        "type": "SentenceBoundary",
        "text": "再加一个全零字节、一个协议号十七，和两字节的 UDP 长度。",
        "offset": 204009444,
        "duration": 56132078
      },
      {
        "type": "SentenceBoundary",
        "text": "这些信息本来就在 IP 首部里，为什么还要再抄一遍？",
        "offset": 260141523,
        "duration": 47169813
      },
      {
        "type": "SentenceBoundary",
        "text": "因为校验必须覆盖 IP 地址：防止数据报被投递到了错误的主机。",
        "offset": 307311337,
        "duration": 59905663
      },
      {
        "type": "SentenceBoundary",
        "text": "伪首部不传输，只参与计算。",
        "offset": 367217000,
        "duration": 28773586
      },
      {
        "type": "SentenceBoundary",
        "text": "协议号十七，就是 UDP 的身份证。",
        "offset": 395990587,
        "duration": 33254718
      }
    ],
