  "s04": {
    "duration": 34.848,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "计算分四步。",
        "offset": 1000000,
        "duration": 15773585
      },
      {
        "type": "SentenceBoundary",
        "text": "第一步，把伪首部、UDP 首部、数据首尾相接，按十六位分组。",
        "offset": 16273585,
        "duration": 60495286
      },
      {
        "type": "SentenceBoundary",
        "text": "校验和字段先填零；数据如果是奇数字节，末尾补一个零字节。",
        "offset": 76768872,
        "duration": 60613210
      },
      {
        "type": "SentenceBoundary",
        "text": "第二步，把所有十六位数加起来。",
        "offset": 137382082,
        "duration": 30188680
      },
      {
        "type": "SentenceBoundary",
        "text": "这里有个坑：溢出不能丢，要把最高位的进位加回最低位。",
        "offset": 167570763,
        "duration": 51533021
      },
      {
        "type": "SentenceBoundary",
        "text": "这个动作叫回卷。",
        "offset": 219103785,
        "duration": 18396227
      },
      {
        "type": "SentenceBoundary",
        "text": "卷一次不够，就再卷一次。",
        "offset": 237500012,
        "duration": 25353774
      },
      {
        "type": "SentenceBoundary",
        "text": "第三步，把得到的和按位取反，就是校验和。",
        "offset": 262853787,
        "duration": 41863209
      },
      {
        "type": "SentenceBoundary",
        "text": "第四步，把它填进首部的校验和字段，发出去。",
        "offset": 304716997,
        "duration": 43278304
      }
    ],
