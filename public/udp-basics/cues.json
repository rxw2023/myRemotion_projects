  "s05": {
    "duration": 41.784,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "拿一个例子走一遍，这是考试最爱的形式。",
        "offset": 1000000,
        "duration": 35584907
      },
      {
        "type": "SentenceBoundary",
        "text": "源地址 192.168.1.1，目的地址 192.168.1.2。",
        "offset": 36084907,
        "duration": 66509437
      },
      {
        "type": "SentenceBoundary",
        "text": "源端口 1024，目的端口 2048，数据是三个字节的 Hel。",
        "offset": 102594345,
        "duration": 60613210
      },
      {
        "type": "SentenceBoundary",
        "text": "长度字段等于 3 加 8，也就是 11。",
        "offset": 163207555,
        "duration": 34787737
      },
      {
        "type": "SentenceBoundary",
        "text": "现在分组：两个 IP 地址各拆成两段，加上零和协议号，一共十二个十六位数。",
        "offset": 197995293,
        "duration": 70400947
      },
      {
        "type": "SentenceBoundary",
        "text": "数据 Hel 只有三字节，补一个零，凑成两个十六位。",
        "offset": 268396240,
        "duration": 45990568
      },
      {
        "type": "SentenceBoundary",
        "text": "累加，中间回卷两次，得到十六位和 43E1。",
        "offset": 314386809,
        "duration": 57547172
      },
      {
        "type": "SentenceBoundary",
        "text": "按位取反，得到 BC1E。",
        "offset": 371933982,
        "duration": 27594341
      },
      {
        "type": "SentenceBoundary",
        "text": "这就是校验和。",
        "offset": 399528323,
        "duration": 17806604
      }
    ],
