  "s07": {
    "duration": 31.392,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "回到设计本身。",
        "offset": 1000000,
        "duration": 17306604
      },
      {
        "type": "SentenceBoundary",
        "text": "UDP 的特点，五条。",
        "offset": 17806604,
        "duration": 23349057
      },
      {
        "type": "SentenceBoundary",
        "text": "第一，无连接：发之前不握手，每个数据报都是独立的。",
        "offset": 41155662,
        "duration": 51533021
      },
      {
        "type": "SentenceBoundary",
        "text": "第二，轻量：没有连接状态，没有拥塞控制，开销只有八个字节。",
        "offset": 92688684,
        "duration": 59787739
      },
      {
        "type": "SentenceBoundary",
        "text": "第三，无序：先发的可能后到，排序要靠应用自己来做。",
        "offset": 152476423,
        "duration": 53066040
      },
      {
        "type": "SentenceBoundary",
        "text": "第四，不可靠：丢了不重传，错了不纠正，也不通知对方。",
        "offset": 205542463,
        "duration": 53655663
      },
      {
        "type": "SentenceBoundary",
        "text": "第五，支持一对多：广播和组播，这一条只有 UDP 能做。",
        "offset": 259198127,
        "duration": 54127361
      }
    ],
    "cues": [
      {
        "text": "回到设计本身。UDP 的特点，五条。",
        "start": 0.1,
        "end": 4.116
      },
      {
        "text": "第一，无连接：发之前不握手，每个数据报都是独立的。",
        "start": 4.116,
        "end": 9.269
      },
      {
        "text": "第二，轻量：没有连接状态，没有拥塞控制，开销只有八个字节。",
        "start": 9.269,
        "end": 15.248
      },
      {
        "text": "第三，无序：先发的可能后到，排序要靠应用自己来做。",
        "start": 15.248,
        "end": 20.554
      },
      {
        "text": "第四，不可靠：丢了不重传，错了不纠正，也不通知对方。",
        "start": 20.554,
        "end": 25.92
      },
      {
        "text": "第五，支持一对多：广播和组播，这一条只有 UDP 能做。",
        "start": 25.92,
        "end": 31.392
      }
    ]
  },
  "s10": {
    "duration": 20.064,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "再回到那张明信片。",
        "offset": 1000000,
        "duration": 20962265
      },
      {
        "type": "SentenceBoundary",
        "text": "寄信的人不负责送达，只负责写清楚地址、投进邮筒。",
        "offset": 21462265,
        "duration": 50117927
      },
      {
        "type": "SentenceBoundary",
        "text": "剩下的事，交给邮局，也交给写信的两个人自己去约定。",
        "offset": 71580192,
        "duration": 51768870
      },
      {
        "type": "SentenceBoundary",
        "text": "UDP 的全部哲学，就在这八个字节里。",
        "offset": 123349063,
        "duration": 35731134
      },
      {
        "type": "SentenceBoundary",
        "text": "它不承诺什么，所以它也几乎不花什么代价。",
        "offset": 159080197,
        "duration": 40919813
      }
    ],
