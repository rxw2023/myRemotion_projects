  "s00": {
    "duration": 32.424,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "先想一个问题：寄一张明信片，你会等对方签收吗？",
        "offset": 1000000,
        "duration": 45962266
      },
      {
        "type": "SentenceBoundary",
        "text": "不会。",
        "offset": 46462266,
        "duration": 10613208
      },
      {
        "type": "SentenceBoundary",
        "text": "写好地址，投进邮筒，剩下的事就与自己无关了。",
        "offset": 57075474,
        "duration": 47051889
      },
      {
        "type": "SentenceBoundary",
        "text": "UDP 就是这样一种协议：不建立连接，也不等确认，发出去就算完。",
        "offset": 104127364,
        "duration": 60849059
      },
      {
        "type": "SentenceBoundary",
        "text": "传输层有两条路，一条是 TCP，一条是 UDP。",
        "offset": 164976424,
        "duration": 49646229
      },
      {
        "type": "SentenceBoundary",
        "text": "TCP 把可靠性做进了协议里，UDP 把这件事留给了应用层。",
        "offset": 214622653,
        "duration": 58726418
      },
      {
        "type": "SentenceBoundary",
        "text": "这一期只讲 UDP：首部、校验，和它为什么还活着。",
        "offset": 273349071,
        "duration": 50353776
      }
    ],
    "cues": [
      {
        "text": "先想一个问题：寄一张明信片，你会等对方签收吗？",
        "start": 0.1,
        "end": 4.696
      },
      {
        "text": "不会。写好地址，投进邮筒，剩下的事就与自己无关了。",
        "start": 4.696,
        "end": 10.413
      },
      {
        "text": "UDP 就是这样一种协议：不建立连接，也不等确认，发出去就算完。",
        "start": 10.413,
        "end": 16.498
      },
      {
        "text": "传输层有两条路，一条是 TCP，一条是 UDP。",
        "start": 16.498,
