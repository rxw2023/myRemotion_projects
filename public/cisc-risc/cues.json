  "s04": {
    "duration": 35.376,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "先看复杂指令集，CISC。",
        "offset": 1000000,
        "duration": 31929247
      },
      {
        "type": "SentenceBoundary",
        "text": "第一条，指令复杂：一条指令里可以既访问内存，又做运算。",
        "offset": 32429247,
        "duration": 56957550
      },
      {
        "type": "SentenceBoundary",
        "text": "第二条，指令不定长：一个字节到十几个字节都有。",
        "offset": 89386797,
        "duration": 46933964
      },
      {
        "type": "SentenceBoundary",
        "text": "第三条，寻址方式多，允许指令直接访问内存。",
        "offset": 136320762,
        "duration": 45636794
      },
      {
        "type": "SentenceBoundary",
        "text": "前三条的后果，是第四条：控制器只能靠微程序。",
        "offset": 181957556,
        "duration": 48584908
      },
      {
        "type": "SentenceBoundary",
        "text": "把一条复杂指令，翻译成一串微指令，存进控制存储器，一条条执行。",
        "offset": 230542465,
        "duration": 62264154
      },
      {
        "type": "SentenceBoundary",
        "text": "第五条，硬件复杂、芯片面积大。",
        "offset": 292806619,
        "duration": 33608492
      },
      {
        "type": "SentenceBoundary",
        "text": "典型代表就是 x86。",
        "offset": 326415111,
        "duration": 26886793
      }
    ],
