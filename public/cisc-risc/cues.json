  "s06": {
    "duration": 28.992,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "把 x86 那条指令放大看，它一次干了五件事。",
        "offset": 1000000,
        "duration": 43485851
      },
      {
        "type": "SentenceBoundary",
        "text": "取 ecx 当基址，把 edx 乘四当偏移，再加上 0x00422000 这个常数。",
        "offset": 43985851,
        "duration": 78537740
      },
      {
        "type": "SentenceBoundary",
        "text": "三者相加，得到有效地址。",
        "offset": 122523591,
        "duration": 27712265
      },
      {
        "type": "SentenceBoundary",
        "text": "再把立即数 0x0A 写进这个地址。",
        "offset": 150235857,
        "duration": 36556605
      },
      {
        "type": "SentenceBoundary",
        "text": "整个过程取指一次、译码一次、访存一次，全在一条指令里完成。",
        "offset": 186792462,
        "duration": 58608493
      },
      {
        "type": "SentenceBoundary",
        "text": "程序短、代码密度高，这是 CISC 的长处。",
        "offset": 245400956,
        "duration": 44103775
      }
    ],
