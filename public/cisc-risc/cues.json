    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "把两者放进同一张表里，这是选择题最常见的样子。",
        "offset": 1000000,
        "duration": 45254719
      },
      {
        "type": "SentenceBoundary",
        "text": "指令集：一个复杂、数量多，一个精简、数量少。",
        "offset": 45754719,
        "duration": 48113210
      },
      {
        "type": "SentenceBoundary",
        "text": "指令长度：一个不定长，一个固定。",
        "offset": 93867929,
        "duration": 33844341
      },
      {
        "type": "SentenceBoundary",
        "text": "寻址模式：一个多，一个少。",
        "offset": 127712271,
        "duration": 29481133
      },
      {
        "type": "SentenceBoundary",
        "text": "控制方式：一个微程序，一个硬布线。",
        "offset": 157193404,
        "duration": 35495284
      },
      {
        "type": "SentenceBoundary",
        "text": "硬件复杂度：一个复杂，一个精简。",
        "offset": 192688689,
        "duration": 34433964
      },
      {
        "type": "SentenceBoundary",
        "text": "优点：一个功能强，一个性能高、功耗低。",
