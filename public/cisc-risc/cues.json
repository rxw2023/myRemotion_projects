  "s07": {
    "duration": 33.288,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "同样一件事，MIPS 怎么做？",
        "offset": 1000000,
        "duration": 25679246
      },
      {
        "type": "SentenceBoundary",
        "text": "先把 i 左移六位，相当于乘六十四；加上 j，再左移两位，乘四。",
        "offset": 26179246,
        "duration": 63089626
      },
      {
        "type": "SentenceBoundary",
        "text": "基址太长，一条指令装不下，只能 lui 取高十六位，ori 补低十六位。",
        "offset": 89268872,
        "duration": 62853776
      },
      {
        "type": "SentenceBoundary",
        "text": "三段相加得到地址，把十装进 a1，最后 sw 写内存。",
        "offset": 152122649,
        "duration": 56721701
      },
      {
        "type": "SentenceBoundary",
        "text": "八条指令，一条不多，一条不少。",
        "offset": 208844350,
        "duration": 31603775
      },
      {
        "type": "SentenceBoundary",
        "text": "每条都只做一件事，译码器看一眼就知道要干什么。",
        "offset": 240448126,
        "duration": 46462266
      },
      {
        "type": "SentenceBoundary",
        "text": "代码变长了，但每一步都简单、规整、可以并行。",
        "offset": 286910392,
        "duration": 45518870
      }
    ],
