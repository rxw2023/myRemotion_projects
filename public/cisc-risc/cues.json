  "s05": {
    "duration": 28.8,
    "sentences": [
      {
        "type": "SentenceBoundary",
        "text": "再看精简指令集，RISC。",
        "offset": 1000000,
        "duration": 26150944
      },
      {
        "type": "SentenceBoundary",
        "text": "指令少而简单，每条只做一件事。",
        "offset": 26650944,
        "duration": 31957548
      },
      {
        "type": "SentenceBoundary",
        "text": "长度固定，ARM 和 MIPS 都是四字节。",
        "offset": 58608493,
        "duration": 35377360
      },
      {
        "type": "SentenceBoundary",
        "text": "寻址方式很少，想算数，先把数据 load 进寄存器。",
        "offset": 93985854,
        "duration": 48231134
      },
      {
        "type": "SentenceBoundary",
        "text": "于是控制器可以用硬布线：组合逻辑直接出控制信号，不查微程序表。",
        "offset": 142216988,
        "duration": 65801890
      },
      {
        "type": "SentenceBoundary",
        "text": "代价是寄存器必须多，少了根本不够用。",
        "offset": 208018879,
        "duration": 37617926
      },
      {
        "type": "SentenceBoundary",
        "text": "硬件精简，功耗低。",
        "offset": 245636805,
        "duration": 22051887
      },
      {
        "type": "SentenceBoundary",
        "text": "典型代表是 ARM。",
        "offset": 267688693,
        "duration": 19811321
      }
    ],
