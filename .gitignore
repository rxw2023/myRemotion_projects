node_modules
dist
build
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out/*

# Scratch TEMP dir used when rendering MP4 (see CLAUDE.md).
# ffmpeg runs sandboxed and cannot write to the system %TEMP%, so renders
# point $env:TEMP here. Safe to delete any time; it is recreated on demand.
.tmp/
*.tmp

# Chrome/Puppeteer dumps its stderr here when the system %TEMP% is not
# writable (same sandbox cause as .tmp/ above). Regenerated on every render.
debug.log


# Ignore generated TTS audio files
public/**/*.mp3

# TTS 逐场产物（sXX.wav，24kHz 单声道），可由 scripts/*/generate_tts.py 重建。
# 只按 sXX 命名排除，别写成 public/**/*.wav ——
# public/*/sfx/ 与 eternal-signal/bed.wav 是真正的音效素材，必须进仓库。
public/*/s[0-9][0-9].wav

# TTS 逐句 PCM 缓存（按引擎分目录，edge 免费、DeepSeek 计费）
scripts/*/.cache/

# Claude Code compatibility junctions created by `npx remotion skills add`
# (Windows junctions cannot be versioned; recreate with the command above).
.claude/

# One-off bundles from `npx remotion bundle --out-dir=.bundleN`
# (128 MB each; only used to render stills quickly, never needed long-term).
.bundle*/

# Agent working memory / session notes (local state, like .claude/)
.workbuddy/

# 本地文档与升级审计记录，只留在本机，不随代码同步
docs/


# Python caches from scripts/ (edge-tts + prep scripts)
__pycache__/
*.pyc
