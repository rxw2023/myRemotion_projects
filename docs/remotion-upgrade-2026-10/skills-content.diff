+        fps={30}
+        width={1920}
+        height={1080}
+        defaultProps={{title: 'Recap'}}
+      />
+    </>
+  );
+};
+```
+
+Both registrations can reuse the same component. Keeping them as separate JSX
+nodes gives each one its own source-editing target.
